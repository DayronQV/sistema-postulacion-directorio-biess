# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# PostgreSQL
POSTGRES_USER=biess
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=biess
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
API_PORT=8080
DATABASE_URL=postgres://biess:cambiar_esta_clave@localhost:5432/biess?sslmode=disable
REDIS_ADDR=localhost:6379
# Mínimo 32 caracteres. Generar uno con: openssl rand -hex 32
# El valor de ejemplo es corto a propósito: el backend no arranca hasta que lo reemplaces.
JWT_SECRET=cambiar_esto
JWT_TTL_MINUTES=60
REQUEST_TIMEOUT_SECONDS=10
# Orígenes del frontend, separados por coma. El primero es la URL del frontend con la
# que se arman los enlaces de los correos (restablecer contraseña): en producción,
# poner primero la URL pública del frontend.
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Correo: "log" escribe los correos en el log del backend en vez de enviarlos (desarrollo).
# En producción se usará "smtp" cuando exista ese adaptador.
MAILER=log

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Producción (docker-compose.prod.yml). Va en un .env del servidor, no en el repositorio.
#   docker compose -f docker-compose.prod.yml up -d --build
# En producción se usan las variables POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB de
# arriba (con claves propias, nunca las de ejemplo), y JWT_SECRET, JWT_TTL_MINUTES,
# REQUEST_TIMEOUT_SECONDS y MAILER. DATABASE_URL, REDIS_ADDR, CORS_ALLOWED_ORIGIN y
# VITE_API_URL las arma el compose solo; las de desarrollo de arriba no se usan.
# Use claves sin símbolos (por ejemplo: openssl rand -hex 24): la de PostgreSQL entra en
# una URL.
# ---------------------------------------------------------------------------
# Dominio público sin https:// (por ejemplo postulacion.midominio.com). Caddy pide el
# certificado HTTPS para este nombre. Si no se define, usa "localhost" (solo pruebas).
DOMINIO=postulacion.example.com

# Respaldo diario con scripts/backup.sh (ver el encabezado del script para el cron).
# Carpeta de destino (por defecto $HOME/backups/biess) y días que se conservan.
# BACKUP_DIR=/home/deploy/backups/biess
# BACKUP_RETENTION_DAYS=7
